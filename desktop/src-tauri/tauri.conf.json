{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveUse",
  "version": "0.2.0",
  "identifier": "com.liveuse.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiveUse",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      },
      {
        "label": "overlay",
        "url": "index.html?view=overlay",
        "title": "LiveUse",
        "width": 420,
        "height": 108,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false,
        "shadow": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
